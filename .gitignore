# PlatformIO / ESP-IDF build output. Regenerated by `pio run` — ~414 MB across
# deck/ and mods/, and far past GitHub's file size limits. Never commit it.
.pio/
.pioenvs/
.piolibdeps/

# ESP-IDF component-manager downloads. Re-fetched from idf_component.yml +
# dependencies.lock on build, so committing them just bloats the repo (~14 MB).
managed_components/

# Node tooling for the catalog/signing scripts.
node_modules/

# Signing key — the firmware catalog is signed with the SAME Ed25519 key as the
# plugin catalog. NEVER commit. Provided to CI via the OBX_PLUGIN_PRIVATE_KEY secret.
.plugin-keys/
*.pem
.env

# Editors / local agent state.
.vscode/
.idea/
.claude/

# NOTE: */dist/*.bin is deliberately NOT ignored. firmware-manifest.json points
# at those local images and scripts/build-firmware-catalog.mjs hashes them into
# the signed firmware.json, so the published .bin files must be tracked.
